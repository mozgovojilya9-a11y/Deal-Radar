# Server-only variable used to validate Telegram Mini App initData.
# Never expose the bot token with a NEXT_PUBLIC_ prefix.
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Optional: override the public GitHub JSON feed URL.
# DEALS_FEED_URL=https://raw.githubusercontent.com/<owner>/<repo>/deals-data/data/deals.json

# Optional Gemini API key for free-tier product research (server-side only).
# Never use a NEXT_PUBLIC_ prefix and never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional extra web-search providers for the AI advisor. Without them the advisor uses
# Brave/Bing/DuckDuckGo/Yahoo HTML search with automatic failover, plus direct
# Marktplaats, 2dehands, Coolblue and MediaMarkt lookups.
# Recommended free option: Tavily (1,000 searches/month, no credit card) — https://app.tavily.com
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=

# Public website (/nl, /en)
# Canonical origin for SEO when a custom domain is connected (otherwise Vercel's production domain).
# NEXT_PUBLIC_SITE_URL=https://dealradar.nl

# Contact form delivery — configure at least one channel, otherwise the form answers "unavailable".
# Telegram: uses TELEGRAM_TOKEN above; the chat id is your own Telegram user id (send /start to the bot,
# then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy message.chat.id).
# CONTACT_TELEGRAM_CHAT_ID=
# Email via Resend (https://resend.com): the sender address must be on a domain verified in Resend.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=Deal Radar <contact@your-domain.nl>
# CONTACT_TO_EMAIL=   # defaults to contactEmail in web/site-config.ts
