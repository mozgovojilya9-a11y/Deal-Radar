# Server-only variable used to validate Telegram Mini App initData.
# Never expose the bot token with a NEXT_PUBLIC_ prefix.
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Optional: override the public GitHub JSON feed URL.
# DEALS_FEED_URL=https://raw.githubusercontent.com/<owner>/<repo>/deals-data/data/deals.json

# Optional Gemini API key for free-tier product research (server-side only).
# Never use a NEXT_PUBLIC_ prefix and never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
