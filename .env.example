# Scanner needs no secrets. Telegram is used only to open the Mini App.
# Keep TELEGRAM_TOKEN server-side in Vercel; do not commit real credentials.

# Optional local path override for exact-model, source-backed new-retail references.
# DEAL_RETAIL_PRICES=retail_prices.json

# Optional Gemini API key for free-tier AI product matching.
# Never commit a real key. Use GitHub Actions Secrets and Vercel Environment Variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_REVIEW_MAX_PER_QUERY=4
